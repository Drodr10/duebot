# Copy me to .env and fill in. Never commit .env — it's in .gitignore.

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Canvas -> Calendar -> "Calendar Feed" (bottom of the right sidebar). Treat like a password.
CANVAS_FEED_URL=https://ufl.instructure.com/feeds/calendars/user_XXXXXXXX.ics

# Your Discord user id (Settings -> Advanced -> Developer Mode, then right-click yourself -> Copy User ID)
OWNER_ID=

# Workshop server id (right-click the server icon -> Copy Server ID). Makes slash commands appear instantly.
GUILD_ID=

# Optional: a friend's user id. You get a DM when they join a voice channel.
WATCH_USER_ID=

# Optional: hour (0-23, Gainesville time) for the daily DM. Default 8.
DIGEST_HOUR=8

# Optional: set to 1 to see the Gateway WebSocket heartbeats in the log.
SHOW_GATEWAY=

# Only for webhook_demo.py
DISCORD_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=
